<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome silhouette, for the playback notification.

  A notification small icon is NOT a small launcher icon: Android discards colour
  and tints the alpha channel, so anything with a plate or a fill arrives as a
  solid blob. This draws only the two shapes that carry the identity - the
  clapper arm and the play triangle - with the notch punched through by evenOdd
  so it stays visible after tinting.

  24dp viewport, which is what this is rasterised at. Detail beyond two shapes
  does not survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M2.8,7.0 L21.2,4.1 L21.2,7.9 L2.8,10.8 Z M10.0,6.0 L12.6,5.6 L11.1,9.2 L8.5,9.6 Z M9.2,12.6 L16.8,16.5 L9.2,20.4 Z" />
</vector>
