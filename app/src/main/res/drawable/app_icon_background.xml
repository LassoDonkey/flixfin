<!--
  Reef adaptive icon background.

  Flat fill, no gradient. Adaptive icon backgrounds get masked to whatever shape
  the launcher wants and can be parallaxed, so any detail here is either cropped
  or smeared. #0B1220 matches the app's own background token.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0B1220"
        android:pathData="M0,0h108v108h-108z" />
</vector>
