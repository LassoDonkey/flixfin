<?xml version="1.0" encoding="utf-8"?>
<!--
  FlixFin adaptive icon background.

  Flat brand red, matching the plate in flixfin-mark-v2.svg. Adaptive backgrounds
  get masked to whatever shape the launcher wants and can be parallaxed against
  the foreground, so any detail here is either cropped or smeared - a solid fill
  is the only thing that survives every launcher.

  Full-strength #8B0000, not the lifted #D14836 the UI uses. That lift exists
  because the canonical red measures 1.99:1 against the app's near-black
  background; an icon is artwork on a launcher shelf, not text on our background,
  so the contrast rule does not apply.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#8B0000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
