<!--
  Reef mark — three concentric arcs rising from a common centre.

  Replaces the Jellyfin mark, which must not be an unofficial client's launcher
  icon (docs/licensing.md). Jellyfin's own logo still appears on the boot screen,
  where it describes what the app connects to rather than who wrote it.

  Geometry notes, because adaptive icons are easy to get subtly wrong:

  - The canvas is 108x108 but only the centre 72x72 is guaranteed visible; a
    launcher may mask to a circle, squircle or rounded square and may parallax
    the layer. Everything here stays inside x/y 18..90 INCLUDING half the stroke
    width, which is the part people forget.
  - Arcs are concentric rather than stacked. Stacked arcs at different centres
    collapse into an unreadable blob once the icon is drawn at 48px.
  - Stroke is 6.5 on a 108 canvas (~6%) — heavy on purpose. Thin strokes vanish
    under TV gamma (docs/tv-constraints.md §9) and at launcher sizes.
  - Colours are explicit, not interpolated: a straight RGB path from coral to
    teal passes through a muddy grey. The middle stop is Jellyfin's own purple.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer arc, r=32 -->
    <path
        android:pathData="M22,66 A32,32 0 0 1 86,66"
        android:strokeColor="#2AB7F0"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Middle arc, r=21.5 -->
    <path
        android:pathData="M32.5,66 A21.5,21.5 0 0 1 75.5,66"
        android:strokeColor="#AA5CC3"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Inner arc, r=11 -->
    <path
        android:pathData="M43,66 A11,11 0 0 1 65,66"
        android:strokeColor="#FF7A59"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />
</vector>
